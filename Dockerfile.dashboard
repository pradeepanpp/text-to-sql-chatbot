# Streamlit dashboard
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    streamlit \
    requests

# The dashboard only talks to the API over HTTP; it needs just its own
# package files (plus the package __init__ files for the import path).
COPY src/__init__.py              src/
COPY src/text_to_sql/__init__.py  src/text_to_sql/
COPY src/text_to_sql/dashboard/   src/text_to_sql/dashboard/

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    API_BASE=http://api:8000

EXPOSE 8501

CMD ["streamlit", "run", \
     "src/text_to_sql/dashboard/app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true"]